# Sentinel AI - Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Provider Configuration
# Which provider to use as the audit agent: OPENAI or ANTHROPIC
AUDIT_PROVIDER=ANTHROPIC

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel_secure_password

# Application
SERVER_PORT=8080
LOG_LEVEL=INFO
